# Optional Firebase Web SDK configuration
# When left blank, SafeWear uses a local browser storage authentication fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Twilio credentials for automatic hands-free SMS & WhatsApp SOS alerts
# Never expose these with a VITE_ prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Example: +15551234567
TWILIO_SMS_FROM=
# Example: +14155238886 (Twilio WhatsApp Sandbox or approved sender number)
TWILIO_WHATSAPP_FROM=
